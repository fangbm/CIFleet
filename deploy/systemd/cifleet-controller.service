[Unit]
Description=CIFleet controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cifleet
Group=cifleet
EnvironmentFile=-/etc/cifleet/controller.env
ExecStart=/usr/local/bin/cifleet-controller
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
