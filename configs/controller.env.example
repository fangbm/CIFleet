# M1 control plane (mTLS)
CIFLEET_LISTEN=:8080
CIFLEET_CA_FILE=/etc/cifleet/pki/ca.crt
CIFLEET_CERT_FILE=/etc/cifleet/pki/controller.crt
CIFLEET_KEY_FILE=/etc/cifleet/pki/controller.key
CIFLEET_NODE_TTL=45s

# M2 GitHub ingress. Keep this loopback-only and publish it through HTTPS.
CIFLEET_WEBHOOK_LISTEN=127.0.0.1:8081
CIFLEET_GITHUB_APP_ISSUER=
CIFLEET_GITHUB_APP_PRIVATE_KEY_FILE=/etc/cifleet/github/app.pem
CIFLEET_GITHUB_WEBHOOK_SECRET_FILE=/etc/cifleet/github/webhook-secret
CIFLEET_GITHUB_API_URL=https://api.github.com
CIFLEET_GITHUB_API_VERSION=2026-03-10
CIFLEET_GITHUB_MARKER_LABEL=cifleet

# JIT runner defaults
CIFLEET_RUNNER_GROUP_ID=1
CIFLEET_RUNNER_IMAGE=ghcr.io/actions/actions-runner:latest
CIFLEET_RUNNER_CPU=2
CIFLEET_RUNNER_MEMORY_MB=4096
CIFLEET_RUNNER_TIMEOUT=2h
CIFLEET_STATE_FILE=/var/lib/cifleet/controller-state.json
